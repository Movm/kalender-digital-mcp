# stdio / single-user: the one key used for every call.
# In HTTP mode it is only a fallback — every caller should send its own key
# as `X-API-KEY` (or `Authorization: Bearer <key>`). Leave it unset for a
# shared multi-user deployment.
KALENDER_DIGITAL_API_KEY=your-api-key

# Optional: run as a remote Streamable HTTP server instead of stdio.
# MCP_TRANSPORT=http
# PORT=3000
# MCP_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com
